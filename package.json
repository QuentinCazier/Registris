{
  "name": "registris",
  "version": "0.2.0",
  "description": "Registre des habilitations et coffre à preuves d'audit pour les établissements publics de santé : qui a obtenu quel accès, sur quel logiciel, sur quelles UF, quand, sur la base de quelle demande, prouvé par quelle pièce.",
  "keywords": [
    "habilitations",
    "acces",
    "audit",
    "cac",
    "certification-des-comptes",
    "pgssi-s",
    "hopital",
    "fph",
    "ldap",
    "active-directory",
    "sqlite"
  ],
  "license": "EUPL-1.2",
  "author": "Quentin Cazier",
  "type": "module",
  "main": "./src/index.js",
  "bin": {
    "registris": "./src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js servir",
    "init": "node src/cli.js init",
    "demo": "node src/cli.js demo",
    "test": "node --test \"tests/*.test.js\"",
    "audit": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "express": "^4.22.2",
    "express-session": "^1.19.0",
    "ldap-authentication": "^4.0.4",
    "multer": "^1.4.5-lts.2",
    "nodemailer": "^9.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "qs": "^6.15.4"
  }
}
