{
  "name": "registris",
  "version": "0.3.1",
  "description": "Registre des habilitations et coffre à preuves d'audit pour les établissements publics de santé : qui a obtenu quel accès, sur quel logiciel, sur quelles UF, quand, sur la base de quelle demande, prouvé par quelle pièce.",
  "keywords": [
    "habilitations",
    "acces",
    "audit",
    "cac",
    "certification-des-comptes",
    "pgssi-s",
    "hopital",
    "fph",
    "ldap",
    "active-directory",
    "sqlite"
  ],
  "homepage": "https://quentincazier.github.io/Registris/",
  "bugs": "https://github.com/QuentinCazier/Registris/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QuentinCazier/Registris.git"
  },
  "license": "EUPL-1.2",
  "author": "Quentin Cazier",
  "type": "module",
  "main": "./src/index.js",
  "bin": {
    "registris": "./src/cli.js"
  },
  "files": [
    "src",
    "public",
    "docs",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "start": "node src/cli.js servir",
    "init": "node src/cli.js init",
    "demo": "node src/cli.js demo",
    "test": "node --test \"tests/*.test.js\"",
    "audit": "npm audit --omit=dev --audit-level=high",
    "lint": "eslint .",
    "types": "tsc -p tsconfig.json",
    "verifier": "npm run lint && npm run types && npm test",
    "charge": "node scripts/charge.mjs"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "ldap-authentication": "^4.0.4",
    "ldapts": "^9.2.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10"
  },
  "overrides": {
    "qs": "^6.15.4"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "typescript": "^7.0.2"
  }
}
