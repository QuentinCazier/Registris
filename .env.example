# Registris : copier ce fichier en .env et adapter. Tout est facultatif.
# La variable d'environnement REGISTRIS_CONFIG désigne un autre fichier de configuration
# (les installateurs le placent hors du dossier de l'application, pour survivre aux mises à jour).

# Nom affiché dans la barre haute, sur la page de connexion et dans les exports
# (ex. « CH de Ville »).
NOM_ETABLISSEMENT=

# Couleur de l'établissement, au format hexadécimal. Elle habille la barre haute,
# les boutons, les liens et l'onglet actif. Les nuances de survol et de fond, ainsi
# que la couleur du texte posé dessus, en sont déduites automatiquement pour rester
# lisibles. Les couleurs de statut (attente, active, close, anomalie) ne changent pas.
COULEUR_ACCENT=#12558f

# --- Serveur ----------------------------------------------------------------
PORT=3000
# Adresse d'écoute. 127.0.0.1 derrière un reverse-proxy (recommandé) ;
# 0.0.0.0 pour exposer directement sur le réseau interne.
HOTE=127.0.0.1
# Secret de signature des sessions. Vide : généré au premier démarrage et conservé dans
# session.secret, à côté de la base.
SESSION_SECRET=
# HTTPS servi directement, sans reverse-proxy : certificat et clé au format PEM, ou un PFX
# (export d'une PKI Windows, algorithme AES256_SHA256). Vide : HTTP, à mettre derrière un reverse-proxy.
TLS_CERT=
TLS_KEY=
TLS_PFX=
TLS_PFX_MOT_DE_PASSE=
# true derrière un reverse-proxy HTTPS (cookie de session sécurisé, HSTS). Automatique si TLS_* est renseigné.
SECURE_COOKIE=false
# true si un reverse-proxy transmet X-Forwarded-For (journalisation des IP).
TRUST_PROXY=false
# NODE_ENV=production refuse les réglages dangereux au démarrage.
NODE_ENV=

# --- Données ------------------------------------------------------------------
# Base SQLite : disque local de la machine, jamais un partage réseau.
DB_PATH=./data/registris.db
# Dossier des pièces de preuve et des logos téléversés.
PREUVES_DIR=./data/preuves
LOGOS_DIR=./data/logos
# Taille maximale d'une pièce (octets). 25 Mo par défaut.
TAILLE_MAX_PREUVE=26214400
# Dossier des fichiers d'ancrage de la chaîne d'audit (idéalement un autre disque
# ou un partage en écriture seule) et destinataire optionnel des ancrages par courriel.
ANCRAGES_DIR=./data/ancrages
ANCRAGE_EMAIL=
# Dossier par défaut des archives produites par « registris sauvegarder ».
SAUVEGARDES_DIR=./sauvegardes
# Adresse par laquelle les agents atteignent l'outil. Sert aux liens des relances.
APP_URL=
# Jours d'attente au-delà desquels une demande est signalée en retard et relancée
# par « registris relancer ».
RELANCE_JOURS=7
# Entretien automatique, toutes les heures, par le serveur lui-même : fermeture
# demandée des accès temporaires arrivés à échéance. « non » pour le confier à une
# tâche planifiée qui lance « registris entretien ».
ENTRETIEN_AUTO=oui
# Années de conservation après la clôture du dernier accès d'un agent. Au-delà,
# « registris purger » efface son identité et supprime ses pièces (docs/RGPD.md).
CONSERVATION_ANNEES=5

# --- Authentification -----------------------------------------------------------
# local : comptes applicatifs (table utilisateurs), pour démarrer ou en secours.
# ldap  : Active Directory de l'établissement (bind LDAPS).
AUTH_MODE=local

# --- Active Directory (si AUTH_MODE=ldap) ---------------------------------------------
LDAP_URL=ldaps://dc.etablissement.local:636
LDAP_BASE_DN=DC=etablissement,DC=local
# Attribut de connexion : sAMAccountName (jdupont) ou userPrincipalName.
LDAP_LOGIN_ATTR=sAMAccountName
# Compte de service EN LECTURE SEULE, pour retrouver l'utilisateur avant le bind.
# Il permet aussi les groupes imbriqués et la recherche d'un agent par matricule.
LDAP_BIND_DN=CN=svc_registris,OU=Services,DC=etablissement,DC=local
LDAP_BIND_PASSWORD=
# Sans compte de service : nom de bind construit à partir de l'identifiant saisi (%s),
# par exemple %s@etablissement.local ou ETABLISSEMENT\%s.
LDAP_USER_DN=
# (facultatif) Restreindre la recherche à une OU.
LDAP_SEARCH_BASE=DC=etablissement,DC=local
# Certificat de l'autorité interne (PEM) si le contrôleur n'est pas reconnu par le système.
LDAP_CA_CERT=
# Délai de connexion et de réponse de l'annuaire, en millisecondes.
LDAP_TIMEOUT_MS=5000
# true pour reconnaître les groupes imbriqués (règle Active Directory en chaîne, compte de service requis).
LDAP_GROUPES_IMBRIQUES=false
# Groupes AD donnant chaque rôle : nom exact du groupe (CN) ou son DN, insensible à la casse.
LDAP_GROUPE_ADMIN=GG_Registris_Admin
LDAP_GROUPE_CONTROLEUR=GG_Registris_Controleur
LDAP_GROUPE_REFERENT=GG_Registris_Referent
LDAP_GROUPE_UTILISATEUR=GG_Registris_Utilisateur

# --- Notifications (relais SMTP interne) ----------------------------------------------
# Vide : aucun courriel envoyé, l'application fonctionne normalement.
SMTP_HOST=
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=registris@etablissement.fr
SMTP_SECURE=false
